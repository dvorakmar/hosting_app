# ============================================
# Git Ignore - Webhosting Manager
# ============================================

# --- Citlivé údaje a konfigurace prostředí ---
.env
*.env
!.env.example

# --- Generovaná klientská data (WordPress weby) ---
# Každý web obsahuje vlastní db.env s přihlašovacími údaji k databázi
data/sites/*
!data/sites/.gitkeep

# --- Logy a audity operací ---
*.log
data/logs/*
!data/logs/.gitkeep

# --- Systémové a editorové soubory ---
.DS_Store
.DS_Store?
._*
.Spotlight-V100
.Trashes
ehthumbs.db
Thumbs.db
.vscode/
.idea/

# --- Dočasné a záložní soubory ---
*.bak
*.tmp
*.swp
*~
*.tar.gz
*.zip
