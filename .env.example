# --- MySQL Cluster / ProxySQL ---
MYSQL_HOST=10.68.2.249
MYSQL_PORT=6033

# Provozní účet pro provisioning (práva CREATE, CREATE USER na wp_%)
MYSQL_USER=webhosting_admin
MYSQL_PASSWORD=WhAdm_9842#kTxL!7qZ

# Vyhrazený účet pro deprovisioning (právo DROP na wp_%)
MYSQL_DEPROVISION_USER=deprovision_admin
MYSQL_DEPROVISION_PASSWORD=DeprAdm_3719#vBnK!8wX

# Volitelně ProxySQL Admin rozhraní (pro automatickou registraci uživatelů)
PROXYSQL_ADMIN_PORT=6032
PROXYSQL_ADMIN_USER=admin
PROXYSQL_ADMIN_PASS=admin

# --- Admin Panel Databáze ---
ADMIN_DB_NAME=webhosting_admin_db
ADMIN_DB_USER=admin_user
ADMIN_DB_PASSWORD=AdmUsr_6421#mRjP!5yC

# --- Síť a Server (Homelab) ---
SERVER_IP=192.168.1.100
ADMIN_PORT=8080

# --- WordPress Konfigurace ---
WP_IMAGE=wordpress:6.7-php8.3-apache
PHP_VERSION=8.3

# --- Cesty v systému (Relativní / Automaticky detekované) ---
# PROJECT_ROOT si skripty zjistí automaticky, není nutné zadávat
DATA_ROOT=./data
SITES_DATA_DIR=./data/sites
# Cesty k souborům se odvozují automaticky z PROJECT_ROOT
# CLIENTS_COMPOSE_FILE=./clients/docker-compose-clients.yml
# ADMIN_COMPOSE_FILE=./admin/docker-compose-admin.yml
LOGS_DIR=./data/logs

